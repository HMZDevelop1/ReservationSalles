<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservationSalles.Pages.DashboardPage"
             Title="Tableau de bord">
  <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="25">
      <Label Text="Réservation de salles" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
      <Label Text="Tableau de bord" FontSize="22" HorizontalOptions="Center" />

      <Border Padding="20" StrokeShape="RoundRectangle 15">
        <VerticalStackLayout Spacing="10">
          <Label Text="Salles disponibles" FontSize="18" HorizontalOptions="Center" />
          <Label x:Name="AvailableCountLabel" Text="0" FontSize="40" FontAttributes="Bold" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>

      <Border Padding="20" StrokeShape="RoundRectangle 15">
        <VerticalStackLayout Spacing="10">
          <Label Text="Réservations simulées" FontSize="18" HorizontalOptions="Center" />
          <Label x:Name="ReservationCountLabel" Text="0" FontSize="40" FontAttributes="Bold" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Border>

      <Button Text="Voir les salles" Clicked="OnVoirSallesClicked" />
      <Button Text="Faire une réservation" Clicked="OnReservationClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
