<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservationSalles.Pages.DetailSallePage"
             Title="Détail de la salle">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="15">
      <Image x:Name="SalleImage" HeightRequest="150" Aspect="AspectFill" />
      <Label x:Name="NomLabel" FontSize="24" FontAttributes="Bold" />
      <Label x:Name="CapaciteLabel" />
      <Label x:Name="LocalisationLabel" />
      <Label x:Name="DisponibiliteLabel" />
      <Label x:Name="EquipementsLabel" />
      <Button Text="Réserver" Clicked="OnReserverClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
