<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReservationSalles.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Tableau de bord"
             BackgroundColor="{StaticResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Réservation de salles" Style="{StaticResource TitrePage}"
                   HorizontalOptions="Center" />
            <Label Text="Consultez les salles et réservez en quelques clics."
                   Style="{StaticResource TexteNormal}" HorizontalTextAlignment="Center" />

            <!-- Deux cartes côte à côte (valeurs liées au ViewModel) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NombreSallesDisponibles}" FontSize="40" FontAttributes="Bold"
                               TextColor="{StaticResource CouleurPrincipale}" HorizontalOptions="Center" />
                        <Label Text="Salles disponibles" Style="{StaticResource TexteNormal}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding NombreTotalSalles, StringFormat='sur {0} au total'}"
                               FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NombreReservations}" FontSize="40" FontAttributes="Bold"
                               TextColor="{StaticResource CouleurPrincipale}" HorizontalOptions="Center" />
                        <Label Text="Réservations" Style="{StaticResource TexteNormal}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Navigation rapide -->
            <Label Text="Navigation" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource CouleurTexte}" />
            <Button Text="Voir la liste des salles" Style="{StaticResource BoutonPrincipal}"
                    Clicked="OnListeClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
