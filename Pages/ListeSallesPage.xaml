<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReservationSalles.Pages.ListeSallesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Liste des salles"
             BackgroundColor="{StaticResource CouleurFond}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Nos salles" Style="{StaticResource TitrePage}" />
            <Label Text="Touchez une salle, puis appuyez sur « Voir les détails »."
                   FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <!-- La salle touchée est enregistrée dans SalleSelectionnee du ViewModel -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Salles}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SalleSelectionnee}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <!-- Modèle d'affichage d'UNE salle -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Carte}">
                        <Grid ColumnDefinitions="80,*" ColumnSpacing="12">

                            <Image Grid.Column="0" Source="salle.png"
                                   HeightRequest="80" WidthRequest="80" VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Nom}" FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource CouleurPrincipale}" />
                                <Label Text="{Binding TexteCapacite, StringFormat='Capacité : {0}'}"
                                       Style="{StaticResource TexteNormal}" />
                                <Label Text="{Binding Localisation}" Style="{StaticResource TexteNormal}" />
                                <Label Text="{Binding TexteDisponibilite}" FontAttributes="Bold"
                                       TextColor="{Binding CouleurDisponibilite}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Actif seulement quand une salle est sélectionnée -->
        <Button Grid.Row="2" Text="Voir les détails"
                Style="{StaticResource BoutonPrincipal}"
                Command="{Binding VoirDetailCommand}" />
    </Grid>
</ContentPage>
