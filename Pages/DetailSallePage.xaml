<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReservationSalles.Pages.DetailSallePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Détail de la salle"
             BackgroundColor="{StaticResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Image Source="salle.png" HeightRequest="140" HorizontalOptions="Center" />

            <Label Text="{Binding Salle.Nom}" Style="{StaticResource TitrePage}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Salle.TexteDisponibilite}" FontAttributes="Bold" FontSize="18"
                   TextColor="{Binding Salle.CouleurDisponibilite}" HorizontalOptions="Center" />

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Capacité" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label Text="{Binding Salle.TexteCapacite}" Style="{StaticResource TexteNormal}" />

                    <Label Text="Localisation" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label Text="{Binding Salle.Localisation}" Style="{StaticResource TexteNormal}" />

                    <Label Text="Équipements disponibles" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label Text="{Binding EquipementsText}" Style="{StaticResource TexteNormal}" />
                </VerticalStackLayout>
            </Border>

            <!-- Une salle occupée ne peut pas être réservée -->
            <Button Text="Réserver cette salle" Style="{StaticResource BoutonPrincipal}"
                    Command="{Binding ReserverCommand}"
                    IsEnabled="{Binding Salle.EstDisponible}" />

            <Button Text="Retour à la liste" Style="{StaticResource BoutonSecondaire}"
                    Clicked="OnRetourClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
