<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReservationSalles.Pages.DetailSallePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Détail de la salle"
             BackgroundColor="{StaticResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Image Source="salle.png" HeightRequest="140" HorizontalOptions="Center" />

            <Label x:Name="labelNom" Style="{StaticResource TitrePage}" HorizontalOptions="Center" />
            <Label x:Name="labelDisponibilite" FontAttributes="Bold" FontSize="18"
                   HorizontalOptions="Center" />

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Description" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label x:Name="labelDescription" Style="{StaticResource TexteNormal}" />

                    <Label Text="Capacité" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label x:Name="labelCapacite" Style="{StaticResource TexteNormal}" />

                    <Label Text="Localisation" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label x:Name="labelLocalisation" Style="{StaticResource TexteNormal}" />

                    <Label Text="Équipements disponibles" FontAttributes="Bold" Style="{StaticResource TexteNormal}" />
                    <Label x:Name="labelEquipements" Style="{StaticResource TexteNormal}" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="boutonReserver" Text="Réserver cette salle"
                    Style="{StaticResource BoutonPrincipal}" Clicked="OnReserverClicked" />
            <Button Text="Retour à la liste" Style="{StaticResource BoutonSecondaire}"
                    Clicked="OnRetourClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
