<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReservationSalles.Pages.DetailSallePage"
             Title="Détail de la salle">
  <ScrollView>
    <VerticalStackLayout Padding="25" Spacing="20">
      <Image x:Name="SalleImage" HeightRequest="200" Aspect="AspectFill" />
      <Label x:Name="NomSalleLabel" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
      <Label x:Name="CapaciteLabel" FontSize="18" />
      <Label x:Name="LocalisationLabel" FontSize="18" />
      <Label Text="Équipements" FontSize="22" FontAttributes="Bold" />
      <Label x:Name="EquipementsLabel" FontSize="18" />
      <Button Text="Réserver cette salle" Clicked="OnReserverClicked" />
      <Button Text="Retour à la liste" Clicked="OnRetourClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
