<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ReservationSalles.Pages.ReservationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             Title="Réservation"
             BackgroundColor="{StaticResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Réserver une salle" Style="{StaticResource TitrePage}" />

            <!-- Salle reçue en paramètre depuis la page de détail -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout>
                    <Label Text="Salle choisie" FontSize="13" TextColor="Gray" />
                    <Label Text="{Binding NomSalle}" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource CouleurPrincipale}" />
                </VerticalStackLayout>
            </Border>

            <!-- Nom -->
            <Label Text="Votre nom" Style="{StaticResource TexteNormal}" Margin="0,8,0,0" />
            <Entry Placeholder="Ex. : Marie Tremblay" Text="{Binding NomUtilisateur}" />

            <!-- Date -->
            <Label Text="Date de réservation" Style="{StaticResource TexteNormal}" />
            <DatePicker Date="{Binding DateReservation}"
                        MinimumDate="{x:Static system:DateTime.Today}" />

            <!-- Plage horaire -->
            <Label Text="Plage horaire" Style="{StaticResource TexteNormal}" />
            <Picker Title="Choisir une plage horaire"
                    ItemsSource="{Binding PlagesHoraires}"
                    SelectedItem="{Binding PlageHoraire}" />

            <!-- Message de validation -->
            <Label Text="{Binding MessageErreur}" Style="{StaticResource MessageErreur}" />

            <Button Text="Confirmer la réservation" Style="{StaticResource BoutonPrincipal}"
                    Margin="0,12,0,0" Command="{Binding ConfirmerCommand}" />
            <Label Text="Entrez votre nom pour activer le bouton."
                   FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
