<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="ReservationSalles.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ReservationSalles">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/StylesProjet.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="CouleurPrincipale">#58A6FF</Color>
            <Color x:Key="CouleurFondLight">#F4F6FA</Color>
            <Color x:Key="CouleurFondDark">#0D1117</Color>
            <Color x:Key="CouleurTexteLight">#1F2937</Color>
            <Color x:Key="CouleurTexteDark">#F0F3F6</Color>
            <Color x:Key="CouleurSecondaireLight">#6B7280</Color>
            <Color x:Key="CouleurSecondaireDark">#B1BAC4</Color>
            <Color x:Key="CouleurCarteLight">#FFFFFF</Color>
            <Color x:Key="CouleurCarteDark">#161B22</Color>
            <Color x:Key="CouleurBordureLight">#D0D6E2</Color>
            <Color x:Key="CouleurBordureDark">#30363D</Color>
            <Color x:Key="CouleurBoutonSecondaireLight">#E5EDF8</Color>
            <Color x:Key="CouleurBoutonSecondaireDark">#212A33</Color>
            <Color x:Key="CouleurErreur">#FF5F5F</Color>
            <Color x:Key="CouleurFond">#0D1117</Color>
            <Color x:Key="CouleurTexte">#F0F3F6</Color>

            <Style x:Key="TitrePage" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CouleurPrincipale}, Dark={StaticResource CouleurPrincipale}}" />
            </Style>

            <Style x:Key="TexteNormal" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CouleurTexteLight}, Dark={StaticResource CouleurTexteDark}}" />
            </Style>

            <Style x:Key="BoutonPrincipal" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CouleurPrincipale}, Dark={StaticResource CouleurPrincipale}}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="BoutonSecondaire" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CouleurBoutonSecondaireLight}, Dark={StaticResource CouleurBoutonSecondaireDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CouleurPrincipale}, Dark={StaticResource CouleurTexteDark}}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="Carte" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CouleurCarteLight}, Dark={StaticResource CouleurCarteDark}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CouleurBordureLight}, Dark={StaticResource CouleurBordureDark}}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="MessageErreur" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource CouleurErreur}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
