<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ReservationSalles.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ReservationSalles.Pages"
       Title="Réservation de salles"
       FlyoutBehavior="Flyout"
       BackgroundColor="{AppThemeBinding Light={StaticResource CouleurPrincipale}, Dark=#0D1117}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource CouleurFondLight}, Dark=#0D1117}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource CouleurPrincipale}, Dark={StaticResource PrimaryDark}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource CouleurSecondaireLight}, Dark={StaticResource CouleurSecondaireDark}}">

    <ShellContent Title="Tableau de bord"
                  Route="DashboardPage"
                  ContentTemplate="{DataTemplate pages:DashboardPage}" />

    <ShellContent Title="Liste des salles"
                  Route="ListeSallesPage"
                  ContentTemplate="{DataTemplate pages:ListeSallesPage}" />

    <ShellContent Title="Réserver une salle"
                  Route="ReservationPage"
                  ContentTemplate="{DataTemplate pages:ReservationPage}" />
</Shell>
